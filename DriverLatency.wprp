<?xml version="1.0" encoding="utf-8"?>
<!-- Minimal kernel trace used by Capture-DriverTrace.ps1: DPC and interrupt events plus the loaded
     driver list, kept in a 512 MB circular memory buffer. -->
<WindowsPerformanceRecorder Version="1.0">
  <Profiles>
    <SystemCollector Id="SystemCollector" Name="NT Kernel Logger">
      <BufferSize Value="1024" />
      <Buffers Value="512" />
    </SystemCollector>
    <SystemProvider Id="SystemProvider">
      <Keywords>
        <Keyword Value="ProcessThread" />
        <Keyword Value="Loader" />
        <Keyword Value="DPC" />
        <Keyword Value="Interrupt" />
      </Keywords>
    </SystemProvider>
    <Profile Id="DriverLatency.Verbose.Memory" Name="DriverLatency" Description="DPC and interrupt time by driver" DetailLevel="Verbose" LoggingMode="Memory">
      <Collectors>
        <SystemCollectorId Value="SystemCollector">
          <SystemProviderId Value="SystemProvider" />
        </SystemCollectorId>
      </Collectors>
    </Profile>
  </Profiles>
</WindowsPerformanceRecorder>
